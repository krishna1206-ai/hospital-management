# Required in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

PORT=4000
SESSION_HOURS=12

# Number of reverse proxies in front of the app (0 if none).
TRUST_PROXY=0

# Optional. Defaults to server/data/hospital.db
# DB_PATH=/var/lib/hospital/hospital.db
