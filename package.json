                         "express":  "^5.3.0",
                         "express-rate-limit":  "^8.7.2",
                         "helmet":  "^8.3.0",
                         "jsonwebtoken":  "^9.0.3",
                         "lucide-react":  "^1.65.0",
                         "react":  "^19.3.1",
                         "react-dom":  "^19.3.1",
